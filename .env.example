# Copy to .env and adjust. Without ANTHROPIC_API_KEY the offline scripted model is used.
LLM_PROVIDER=auto            # auto | anthropic | fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p2_agent
STORAGE=postgres             # postgres | memory

MAX_AGENT_STEPS=8
RECURSION_LIMIT=30
REFUND_HARD_LIMIT_CENTS=200000

# Mock payments API chaos
PAYMENTS_MODE=inprocess      # inprocess | http
PAYMENTS_BASE_URL=http://localhost:8000/mock-payments
PAYMENTS_LATENCY_MS=0
PAYMENTS_FAIL_FIRST=0
PAYMENTS_FAILURE_RATE=0.0
PAYMENTS_RETRY_ATTEMPTS=3
